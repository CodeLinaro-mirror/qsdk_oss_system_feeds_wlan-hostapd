Index: b/wpa_supplicant/wpa_supplicant.c
===================================================================
--- a/wpa_supplicant/wpa_supplicant.c	2023-03-05 16:34:57.560662656 +0530
+++ b/wpa_supplicant/wpa_supplicant.c	2023-03-05 16:34:57.544662763 +0530
@@ -2835,7 +2835,10 @@ skip_to_6ghz:
 					break;
 			}
 
-			seg0 = ibss_get_center_320mhz(freq->channel);
+			if (ssid->ccfs)
+				seg0 = ssid->ccfs;
+			else
+				seg0 = ibss_get_center_320mhz(freq->channel);
 			chwidth = CHANWIDTH_320MHZ;
 		} else {
 			/* There is only one 320MHz(240+80 Punctured) in 5 GHz Band */
Index: b/wpa_supplicant/wpa_supplicant.conf
===================================================================
--- a/wpa_supplicant/wpa_supplicant.conf	2023-03-05 16:34:56.984666485 +0530
+++ b/wpa_supplicant/wpa_supplicant.conf	2023-03-05 16:45:37.128399197 +0530
@@ -922,6 +922,12 @@ fast_reauth=1
 # an IBSS network with the configured SSID is already present, the frequency of
 # the network will be used instead of this configured value.
 #
+# ccfs: Channel center frequency index for IBSS when operating
+# bandwidth is 320 MHz. 320 MHz has overlapping 160 MHz bands and by default
+# center frequency index will be selected from non overlapping band. This value
+# can be optionally configured and used when user wants specific
+# center frequency index.
+#
 # pbss: Whether to use PBSS. Relevant to IEEE 802.11ad networks only.
 # 0 = do not use PBSS
 # 1 = use PBSS
