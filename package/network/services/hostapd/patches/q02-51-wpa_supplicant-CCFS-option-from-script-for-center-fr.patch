+++ b/wpa_supplicant/config.c	2023-03-05 16:34:57.528662869 +0530
@@ -2814,6 +2814,7 @@ static const struct parse_data ssid_fiel
 	{ INT_RANGE(enable_160mhz_bw, 0, 1)},
 	{ INT_RANGE(enable_320mhz_bw, 0, 1)},
 	{ INT(ru_punct_bitmap) },
+	{ INT(ccfs) },
 };
 
 #undef OFFSET
Index: b/wpa_supplicant/config_file.c
===================================================================
