+	else
+		total_len += MLE_COMMON_INFO_AUTH;
+
+	/* TODO EML caps and Medium Synchronization Delay Info fields */
+
+	if (ml_data == NULL || !ml_data->present)
+		return total_len;
+
+	if (type != WLAN_FC_STYPE_PROBE_RESP && type != WLAN_FC_STYPE_ASSOC_RESP) {
+		wpa_printf(MSG_ERROR, "Link info is not expected frames except"
+			   " ML Probe response and Assoc Req/Response");
+		return total_len;
+	}
+
+	/* No Link info added for SLO */
+
+	return total_len;
+}
+
+
+u8 * hostapd_eid_basic_mle(struct hostapd_data *hapd, u8 *eid, u32 type,
+			   struct multi_link_data *ml_data)
+{
+	u8 *eid_len, *eid_cmn_info_len;
+	u16 presence_bmap = 0;
+
+	if (!hapd->is_mld)
+		return eid;
+
+	*eid++ = WLAN_EID_EXTENSION;
+	eid_len = eid++;
+	*eid++ = WLAN_EID_EXT_EHT_MULTI_LINK;
+
+	if (type != WLAN_FC_STYPE_AUTH) {
+		/* Fill these info by default currently */
+		presence_bmap = MLE_LINK_ID_PRESENT | MLE_BSS_PARAM_CHANGE_PRESENT |
+				MLE_MLD_CAP_PRESENT;
+	}
+
+	*eid++ = MLE_TYPE_BASIC | ((presence_bmap & 0x0f) << MLE_PRESENCE_BMAP_SHIFT);
+
+	*eid++ = presence_bmap >> MLE_PRESENCE_BMAP_SHIFT;
+
+	eid_cmn_info_len = eid++;
+
+	os_memcpy(eid, hapd->mld_addr, ETH_ALEN);
+	wpa_printf(MSG_DEBUG, "Frame %d " MACSTR ,type,
+		   MAC2STR(hapd->mld_addr));
+
+	eid += ETH_ALEN;
+
+	if (presence_bmap & MLE_LINK_ID_PRESENT)
+		*eid++ = hapd->iface->link_id;
+
+	if (presence_bmap & MLE_BSS_PARAM_CHANGE_PRESENT)
+		*eid++ = 0; /* TODO */
+
+	/* TODO EML caps and Medium Synchronization Delay Info fields */
+
+	if (presence_bmap & MLE_MLD_CAP_PRESENT) {
+		*eid++ = 0;
+		*eid++ = 0; /* TODO Other caps info not present */
+	}
+
+	*eid_cmn_info_len = eid - eid_cmn_info_len ;
+
+	*eid_len = eid - eid_len - 1;
+
+	if (ml_data == NULL || !ml_data->present)
+		return eid;
+
+	if (type != WLAN_FC_STYPE_PROBE_RESP && type != WLAN_FC_STYPE_ASSOC_RESP) {
+		wpa_printf(MSG_ERROR, "Link info is not expected frames except"
+			   " ML Probe response and Assoc Req/Response");
+		return eid;
+	}
+
+	/* No Link info added for SLO */
+
+	*eid_len = eid - eid_len - 1;
+	return eid;
+}
+
+static void hostapd_parse_probe_req_mle(struct hostapd_data *hapd,
+					const u8 *mle, u8 len,
+					struct multi_link_data *ml_data)
+{
+	bool mld_id_present = ml_data->control.presence & MLE_MLD_ID_PRESENT;
+	u8 mld_id, cmn_info_len;
+	u8 *mle_pos = (u8 *)mle;
+
+	if (!len) {
+		ml_data->present = false;
+		return;
+	}
+
+	cmn_info_len = *mle_pos;
+
+	/* For non Tx vaps MLD ID will not be present, A1/3 match done at caller */
+	if (mld_id_present) {
+		if (cmn_info_len < 2) {
+			wpa_printf(MSG_ERROR, "Wrongly encoded MLD Id in probe request");
+			ml_data->present = false;
+			return;
+		}
+		mld_id = *(mle_pos + 1);
+
+		if (mld_id != hapd->mld_id) {
+			wpa_printf(MSG_ERROR, "MLD ID mismatch in ML Probe request");
+			ml_data->present = false;
+		}
+	}
+
+	/* No parsing for link ids for SLO done */
+}
+
+static void hostapd_parse_basic_mle(struct hostapd_data *hapd,
+				    const u8 *mle, u16 len,
+				    struct multi_link_data *ml_data)
+{
+	u8 *mle_pos = (u8 *)mle;
+
+	/* Currently used only for assoc/reassoc req basic mle parsing */
+	if (!len)
+		return;
+
+	if (len < *mle_pos)
+		return;
+
+	/* Common length */
+	mle_pos++;
+	len--;
+
+	memcpy(ml_data->basic.mld_addr, mle_pos, ETH_ALEN);
+	mle_pos += ETH_ALEN;
+	len -= ETH_ALEN;
+
+	if (ml_data->control.presence & MLE_EML_CAP_PRESENT) {
+		/* TODO EML caps */
+		mle_pos += 2;
+		len -= 2;
+	}
+
+	if (ml_data->control.presence & MLE_MLD_CAP_PRESENT) {
+		/* TODO MLD caps */
+		mle_pos += 2;
+		len -= 2;
+	}
+
+	if (ml_data->control.presence & MLE_BASIC_MLD_ID_PRESENT) {
+		/* TODO MLD ID */
+		mle_pos += 1;
+		len -= 1;
+	}
+
+	if (!len)
+		return;
+
+	wpa_printf(MSG_DEBUG, " Link info should not be present for SLO");
+	/* Link Info shouldnt be present for SLO */
+	ml_data->present = false;
+}
+
+void hostapd_parse_mle(struct hostapd_data *hapd, u32 type,
+		       struct ieee802_11_elems *elems,
+		       struct multi_link_data *ml_data)
+{
+	const u8 *mle;
+	struct wpabuf *mle_buf = NULL;
+
+	u16 len;
+
+	if (!elems->mle || !hapd->is_mld)
+		return;
+
+	if (elems->mle_len < sizeof(struct multi_link_control))
+		return;
+
+	ml_data->present = true;
+
+	/* TODO reconsider defrag case only for Assoc/reassoc */
+	/* Note: The buf cannot be dealloc in this func, since the caller
+	 * uses some part of it for per sta profile info.
+	 */
+	mle_buf = ieee802_11_defrag(elems, WLAN_EID_EXTENSION,
+				    WLAN_EID_EXT_EHT_MULTI_LINK);
+
+	if (!mle_buf) {
+		wpa_printf(MSG_ERROR, "MLE buf allocation failed on defragmentation");
+		ml_data->present = false;
+		return;
+	}
+
+	mle = wpabuf_head(mle_buf);
+	len = wpabuf_len(mle_buf);
+
+	os_memcpy(&ml_data->control, mle, sizeof(struct multi_link_control));
+
+	mle += sizeof(struct multi_link_control);
+	len -= sizeof(struct multi_link_control);
+
+	if (ml_data->control.type == MULTI_LINK_PROBE_REQ &&
+	    type == WLAN_FC_STYPE_PROBE_REQ) {
+		hostapd_parse_probe_req_mle(hapd, mle, len, ml_data);
+
+		/* If the ML probe req was invalid, free the buf*/
+		if (ml_data->present == false)
+			wpabuf_free(mle_buf);
+		return;
+	}
+
+	if (type == WLAN_FC_STYPE_AUTH) {
+		/* Common info len should have only MLD mac addr */
+		if (*mle++ != ETH_ALEN + 1 || ml_data->control.presence) {
+			wpa_printf(MSG_ERROR, "Unexpected info present in AUTH basic MLE");
+			ml_data->present = false;
+			wpabuf_free(mle_buf);
+			return;
+		}
+		memcpy(ml_data->basic.mld_addr, mle, ETH_ALEN);
+		return;
+	}
+
+	if (type != WLAN_FC_STYPE_ASSOC_REQ &&
+	    type != WLAN_FC_STYPE_REASSOC_REQ) {
+		ml_data->present = false;
+		wpabuf_free(mle_buf);
+		return;
+	}
+
+	if (ml_data->control.presence & (MLE_LINK_ID_PRESENT | MLE_BSS_PARAM_CHANGE_PRESENT |
+	    MLE_MEDIUM_SYNC_DELAY_PRESENT)) {
+		wpa_printf(MSG_ERROR, "Unexpected info present in (Re)Assoc Req MLE");
+		ml_data->present = false;
+		wpabuf_free(mle_buf);
+		return;
+	}
+
+	hostapd_parse_basic_mle(hapd, mle, len, ml_data);
+	ml_data->buf = mle_buf;
+}
