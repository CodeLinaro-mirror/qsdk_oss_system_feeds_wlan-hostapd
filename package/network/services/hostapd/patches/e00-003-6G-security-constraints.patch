 src/drivers/driver.h         |  14 ++++
 src/drivers/driver_nl80211.c | 140 +++++++++++++++++++++++++++++++----
 wpa_supplicant/ap.c          |   1 +
 4 files changed, 144 insertions(+), 13 deletions(-)

