From: Sidharth Renukadevi <srenukad@qti.qualcomm.com>
Wed Jul 1 12:44:07 2026 +0530

Subject: [PATCH] UPSTREAM: PROTOCOL: hostapd: Clean up stale non-ML STA entries and guard
wpa_sm assignment during MLO association

During authentication handling, when a new STA is added, hostapd attempts
to remove existing STA entries on other links. However, this cleanup
currently applies only to MLO STA entries. Legacy/non-ML STA entries on
other links are not removed and can persist across retries.

Later, during association handling,
set_wpa_sm_for_each_partner_link() propagates the association-link
wpa_sm to partner-link STA entries without verifying that the STA
actually belongs to the same MLD. As a result, stale legacy/non-ML STA
entries can incorrectly receive the ML association STA's wpa_sm.

This leads to multiple STA entries sharing the same wpa_sm pointer.
When one of these STA entries is subsequently cleaned up, the shared
wpa_sm can be freed while still referenced by another STA. This leaves
dangling or NULL wpa_sm pointers, causing invalid memory accesses and
hostapd crashes during later cleanup or state transitions.

Fix this by cleaning up non-ML STA entries in
ap_sta_remove_link_sta() and validating the association link before
propagating wpa_sm.

Patch-dependency: None

Signed-off-by: Sidharth Renukadevi <srenukad@qti.qualcomm.com>

diff --git a/src/ap/sta_info.c b/src/ap/sta_info.c
index 8774426..36e3b9f 100644
--- a/src/ap/sta_info.c
+++ b/src/ap/sta_info.c
@@ -305,8 +305,8 @@ static void __ap_free_sta(struct hostapd_data *hapd, struct sta_info *sta)


 #ifdef CONFIG_IEEE80211BE
-static void clear_wpa_sm_for_each_partner_link(struct hostapd_data *hapd,
-					       struct sta_info *psta)
+void set_wpa_sm_for_each_partner_link(struct hostapd_data *hapd,
+					struct sta_info *psta, void *wpa_sm)
 {
	struct sta_info *lsta;
	struct hostapd_data *lhapd;
@@ -320,8 +320,15 @@ static void clear_wpa_sm_for_each_partner_link(struct hostapd_data *hapd,

		lsta = ap_get_sta(lhapd, psta->addr);
		if (lsta && (psta->mld_assoc_link_id == lsta->mld_assoc_link_id))
-			lsta->wpa_sm = NULL;
+			lsta->wpa_sm = wpa_sm;
	}
+
+}
+
+void clear_wpa_sm_for_each_partner_link(struct hostapd_data *hapd,
+					       struct sta_info *psta)
+{
+	set_wpa_sm_for_each_partner_link(hapd, psta, NULL);
 }
 #endif /* CONFIG_IEEE80211BE */

@@ -2371,10 +2378,9 @@ void ap_sta_remove_link_sta(struct hostapd_data *hapd,
			if(check_authorized && ap_sta_is_authorized(tmp_sta))
				continue;

-			if (ap_sta_is_mld(tmp_hapd, tmp_sta)) {
-				ap_free_sta(tmp_hapd, tmp_sta);
-				break;
-			}
+			ap_free_sta(tmp_hapd, tmp_sta);
+			break;
+
		}
	}
 }
diff --git a/src/ap/sta_info.h b/src/ap/sta_info.h
index 7e40d3c..72efb69 100644
--- a/src/ap/sta_info.h
+++ b/src/ap/sta_info.h
@@ -531,6 +531,12 @@ void ap_sta_free_sta_profile(struct mld_info *info);

 void hostapd_free_link_stas(struct hostapd_data *hapd);

+void set_wpa_sm_for_each_partner_link(struct hostapd_data *hapd,
+					struct sta_info *psta, void *wpa_sm);
+
+void clear_wpa_sm_for_each_partner_link(struct hostapd_data *hapd,
+					struct sta_info *psta);
+
 void set_valid_for_each_partner_link_sta(struct hostapd_data *hapd,
                                            struct sta_info *psta,
                                            int valid);
