 }
 
+static int driver_nl80211_if_link_remove(void *priv, enum wpa_driver_if_type type,
+					 const char *ifname, int link_id)
+{
+	struct i802_bss *bss = priv;
+
+	if (link_id < 0 || link_id >= MAX_NUM_MLD_LINKS)
+		return -1;
+
+	if (type != WPA_IF_AP_BSS)
+		return -1;
+
+	if (!nl80211_valid_link(bss, link_id))
+		return -1;
+
+	return wpa_driver_nl80211_if_link_remove(bss, type, ifname, link_id);
+}
 
 static int driver_nl80211_send_mlme(void *priv, const u8 *data,
 				    size_t data_len, int noack,
@@ -13800,6 +13860,29 @@ fail:
 	return ret;
 }
 
+bool wpa_driver_get_shared_status(void *priv, void *bss_ctx)
+{
+	struct i802_bss *bss = priv;
+	struct wpa_driver_nl80211_data *drv = bss->drv;
+
+	for (bss = drv->first_bss; bss; bss = bss->next) {
+		/* more than one links means some one is still using */
+		if (bss->n_links > 1)
+			return true;
+
+		/* if its 1 then it could be SLO or invalid entry. Need
+		 * to check the link ID. But need to check only if the link
+		 * BSS context is not same as self since self can exist and
+		 * will be removed when deinitializing the driver
+		 */
+		if (bss->flink->ctx != bss_ctx &&
+		    bss->flink->link_id != NL80211_DRV_LINK_ID_NA)
+			return true;
+	}
+
+	return false;
+}
