+static void hostapd_update_first_link_bss(struct hostapd_data *hapd,
+					  struct hostapd_data *new_first_bss)
+{
+	struct hapd_interfaces *interfaces = hapd->iface->interfaces;
+	struct hostapd_iface *iface;
+	struct hostapd_data *bss;
+	struct hostapd_bss_config *conf;
+	size_t i, j;
+
+	for (i = 0; i < interfaces->count; i++) {
+		iface = interfaces->iface[i];
+		if (!iface || iface == hapd->iface)
+			continue;
+
+		for (j = 0; j < iface->num_bss; j++) {
+			bss = iface->bss[j];
+			if (!bss)
+				continue;
+
+			if (bss == new_first_bss)
+				continue;
+
+			conf = bss->conf;
+			if (!conf->mld_ap)
+				continue;
+
+			if (!hostapd_is_ml_partner(hapd, bss))
+				continue;
+
+			wpa_printf(MSG_DEBUG, "MLD %s: Link %d: Updated first_link BSS %d -> %d",
+				   conf->iface, bss->mld_link_id,
+				   hapd->mld_first_bss ? hapd->mld_first_bss->mld_link_id :
+				   			 hapd->mld_link_id,
+				   new_first_bss->mld_link_id);
+			bss->mld_first_bss = new_first_bss;
+		}
+	}
+}
+
+/* hostapd_bss_link_deinit - Per-BSS ML cleanup (deinitialization)
+ * @hapd: Pointer to BSS data
+ *
+ * This function is used to unlink the BSS from the partner BSSes.
+ * If the BSS being removed is the first link and other link exists,
+ * then it passes the data stored in it to the next link and make that
+ * link as the first BSS.
+ */
+static void hostapd_bss_link_deinit(struct hostapd_data *hapd)
+{
+#ifdef CONFIG_IEEE80211BE
+	if (hapd->conf->mld_ap && hapd->drv_priv &&
+	    !is_zero_ether_addr(hapd->mld_addr)) {
+		if (!hapd->mld_first_bss) {
+			struct hostapd_data *next, *link_bss;
+
+			/* Going to delete first BSS in MLD. Make the next entry as
+			 * first BSS and adjust first bss pointer of the rest all
+			 * link BSS
+			 */
+			if (dl_list_len(&hapd->links) >= 1) {
+				next = dl_list_entry(hapd->links.next,
+						     struct hostapd_data,
+						     links);
+
+				/* adjust first BSS pointer for all partner links
+				 * Can't use for_each_partner_bss() since a few
+				 * partner links could be in DISABLED state hence
+				 * unlinked from the list temproarily
+				 */
+				hostapd_update_first_link_bss(hapd, next);
+
+				/* copy mld_next_link_id value from old first BSS
+				 * to this new first BSS
+				 */
+				next->mld_next_link_id = hapd->mld_next_link_id;
+
+				/* make this as first BSS */
+				next->mld_first_bss = NULL;
+
+				/* make the old first BSS to point to this new
+				 * first BSS
+				 */
+				hapd->mld_first_bss = next;
+
+				wpa_printf(MSG_DEBUG, "MLD %s: Link %d: First link changed to %d",
+					   hapd->conf->iface, hapd->mld_link_id,
+					   next->mld_link_id);
+				wpa_printf(MSG_DEBUG, "MLD %s: First link changed %d -> %d",
+					   hapd->conf->iface, hapd->mld_link_id,
+					   next->mld_link_id);
+			}
+		}
+		wpa_printf(MSG_DEBUG, "MLD: Link %d unlinked from MLD interface %s",
+			   hapd->mld_link_id, hapd->conf->iface);
+		dl_list_del(&hapd->links);
+	}
+#endif
+}
 
